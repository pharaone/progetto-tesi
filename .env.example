# LLM Provider: ollama or anthropic
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b

# Anthropic settings (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ChromaDB settings
CHROMADB_PATH=/data/chromadb

# Microservice URLs (used by orchestrator)
AS1_URL=http://as1:8001
AS2_URL=http://as2:8002
AS3_URL=http://as3:8003
AGA_URL=http://aga:8004
AIU_URL=http://aiu:8005

# Orchestrator URL (used by UI)
ORCHESTRATOR_URL=http://orchestrator:8000

# Timeouts (seconds)
AS_TIMEOUT=300
AGA_TIMEOUT=120
AIU_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
