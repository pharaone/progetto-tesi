# -----------------------------------------------------------------------------
# Company (single-company deployment: one container group = one company)
# -----------------------------------------------------------------------------
ORG_ID=company

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret used to sign auth tokens — change it to a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Certifier account, seeded at first startup of the orchestrator.
# Employees register themselves from the login page.
CERTIFIER_USERNAME=certifier
CERTIFIER_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Monitoring (Grafana at http://localhost:3000, Prometheus at http://localhost:9090)
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=admin

# LLM Provider: ollama or anthropic
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b

# Anthropic settings (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ChromaDB settings
CHROMADB_PATH=/data/chromadb

# Microservice URLs (used by orchestrator)
AS1_URL=http://as1:8001
AS2_URL=http://as2:8002
AS3_URL=http://as3:8003
AGA_URL=http://aga:8004
AIU_URL=http://aiu:8005

# Orchestrator URL (used by UI)
ORCHESTRATOR_URL=http://orchestrator:8000

# Timeouts (seconds). AS agents make one LLM call per requirement (10-30+
# each) — with CPU-only inference a single call can take 1-2 minutes, so
# keep these generous. Lower them if you use a GPU or a hosted LLM.
AS_TIMEOUT=3600
AGA_TIMEOUT=600
AIU_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
